# =====================================================================
# 一加 9R (LE2100 / lemonades) + ColorOS 14 (Android 14, 14.0.0.605)
# KernelSU_action 构建配置 —— SukiSU-Ultra (builtin) + SUSFS 1.5.5（kona lemonades 4.19）
# 仓库模板: https://github.com/xiaoleGun/KernelSU_action
# =====================================================================
CONFIG_ENV=config.env

# ---------------------------------------------------------------------
# 内核源码：OnePlus 官方开源仓库（分支已确认为 Android 14 / 9R）
# 仓库: https://github.com/OnePlusOSS/android_kernel_oneplus_sm8250
# 分支: oneplus/sm8250_u_14.0.0_op9r          <- ColorOS 14 / 9R
# 其它可参考分支:
#   oneplus/sm8250_t_13.1_op9r                <- Android 13.1 / 9R
#   oneplus/sm8250_u_14.0.0_op8t              <- Android 14 / 8T
# ---------------------------------------------------------------------
KERNEL_SOURCE=https://github.com/OnePlusOSS/android_kernel_oneplus_sm8250
KERNEL_SOURCE_BRANCH=oneplus/sm8250_u_14.0.0_op9r

# 官方 defconfig（已确认该分支下存在 arch/arm64/configs/vendor/kona-perf_defconfig）
KERNEL_CONFIG=vendor/kona-perf_defconfig

# 一加 SM8250 原厂 boot 里的内核是未压缩 Image（实测 KERNEL_FMT=raw）
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# 留空：不要让它改 CONFIG_LOCALVERSION，版本串必须保持官方值
KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# 注意：这里不要加 LLVM_IAS=1。
# 内核 Makefile:591 在没传 LLVM_IAS=1 时会加 -no-integrated-as，把 clang
# 生成的 .s 交给 AOSP GCC 4.9 的 binutils 汇编——这是 Android 4.19 内核的
# 标准做法。改用 clang 内置汇编器会踩 arm64/include/asm/alternative.h 的
# .org 对齐缺陷（atomic_lse.h 报 "invalid .org offset"），而那个 vdso 的
# "file number less than one" 问题真正的原因是 DEBUG_INFO=y 让 clang 输出
# DWARF5 的 .file 0，已经在 EXTRA_DEFCONFIG 里用 CONFIG_DEBUG_INFO=n 解决。
EXTRA_CMDS=KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

# ---------------------------------------------------------------------
# 工具链：4.19 老内核必须用 2022 版 clang，新版基本编不过
# ---------------------------------------------------------------------
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=false

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# ---------------------------------------------------------------------
# Root 方案：SukiSU-Ultra (builtin) + SUSFS（模板官方 non-GKI 示例组合）
#   4.19 属 non-GKI：hook 必须 manual，path_umount 必须回移
#   注意：sukisu-ultra 的 main 树在 4.19 上因 kernel_includes.h 无条件
#   包含 <linux/static_call.h>（5.10 接口）编译失败——教训只适用于 main，
#   builtin 分支无此问题且自带 SUSFS 集成（scripts/patches.sh 的
#   susfs_is_bundled 会自动跳过 KSU 侧补丁）。
# ---------------------------------------------------------------------
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=manual
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =====================================================================
# SUSFS 组合（当前采用：SukiSU-Ultra builtin + susfs4ksu 内核侧补丁）
# ---------------------------------------------------------------------
# KSU_VARIANT=sukisu-ultra / KSU_REF=builtin / ENABLE_SUSFS=true：
#   内核侧 SUSFS 本体来自 susfs4ksu 的 50_add_susfs_in_kernel-4.19.patch
#   = SUSFS v1.5.5（NON-GKI，susfs4ksu kernel-4.19 分支最后提交 2025-02-23）；
#   KSU 侧对接由 builtin 树自带（scripts/patches.sh 检测到 CONFIG_KSU_SUSFS
#   后自动跳过 10_enable_susfs_for_ksu.patch，不会 die "SUSFS integration failed"）。
#   4.19 上最高只能到 1.5.5 —— 2.x 只存在于 GKI（5.10+）分支。
#   管理器要用 SukiSU-Ultra 官方 app（BakaSU/RKSU 管理器与此变体不配套）。
# 备选【方案 C】：KSU_VARIANT=rsuntk / KSU_REF=susfs-rksu-master /
#   ENABLE_SUSFS=true（若 builtin 静态编译失败再换，见上方 static_call 教训）。
# =====================================================================
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=kernel-4.19

# path_umount 是 Linux 5.9 才有的，4.19 必须回移，否则"卸载模块挂载"失效
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true
# MODVERSIONS CRC 容忍：OPPO 内部树与 OnePlusOSS 公开树漂移导致 genksyms CRC
# 不一致（实测 kmem_cache_alloc_trace / kmalloc_caches err -22），非 module_layout
# 符号不匹配降级为警告放行；module_layout（struct module 布局）仍严格校验
ENABLE_MODVERSIONS_TOLERANCE=true
# 相机 KMD 恢复：12+ 的 OSS 树把 techpack/camera 变成不可 fetch 的 submodule，
# 相机 HAL 会因 KMD 缺失每 5 秒崩溃、开机无法完成。从 R_11 分支回植 kona 相机
# 驱动源码（Makefile 自带 CONFIG_SPECTRA_CAMERA=y，无需改 defconfig）
ENABLE_CAMX_KMD=true
# KPM 只在 sukisu-ultra 的 main 树里有，builtin 没有；要 KPM 请改 main
ENABLE_KPM=false

# ---------------------------------------------------------------------
# Kconfig 追加项（最后应用，优先级最高，格式只接受 CONFIG_X=值）
# ---------------------------------------------------------------------
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# 关键两行：
#  1) MODULE_SIG_FORCE=n —— 原厂 /vendor/lib/modules 里的 .ko 是用一加
#     构建密钥签名的；我们自己重编内核会生成新密钥，若不关掉强制验签，
#     45 个模块（含 wlan / 音频）全部会被拒 → 无 Wi-Fi、无声音。
#  2) LOCALVERSION 固定为 "-perf" —— 保证 vermagic 精确等于
#     "4.19.157-perf+ SMP preempt mod_unload modversions aarch64"，
#     否则模块因 vermagic 不匹配被拒。
#  3) 打开 seccomp 过滤器（4.19 原生支持，只是官方 defconfig 未显式开启）
#  4) DEBUG_INFO=n —— 原 defconfig 开着调试信息，clang 14 会生成 DWARF5，
#     老 binutils 汇编不过；而且 Image 会大出 30%+，boot 分区吃不消。
#     发布用的内核不需要调试信息，关掉还能显著缩短构建时间。
#
# 【绝对不能加外层引号，也不能写 \" 转义】——这是实测踩过的坑。
# 模板 scripts/config.sh 的 cfg_read 用 sed 取 "键=之后到行尾的全部内容"，
# 不去引号、不做反转义，然后 build.sh 按空格切词：
#   EXTRA_DEFCONFIG="CONFIG_MODULE_SIG_FORCE=n CONFIG_LOCALVERSION=\"-perf\" ..."
# 会被切成 token `"CONFIG_MODULE_SIG_FORCE=n`（行首多一个引号）+ `CONFIG_LOCALVERSION=\"-perf\"`，
# 结果 defconfig 里出现两行垃圾：
#   # CONFIG_"CONFIG_MODULE_SIG_FORCE is not set
#   CONFIG_LOCALVERSION=\"-perf\"
# 于是 ① MODULE_SIG_FORCE 仍为 y → 45 个原厂签名模块全部被拒（无 Wi-Fi 无声音）
#      ② LOCALVERSION 被 Kconfig 丢弃 → uname -r 变成 4.19.157（丢 -perf）
# 正确写法就是像 EXTRA_CMDS 那样光着写：值内部按需保留双引号，外层不加。
EXTRA_DEFCONFIG=CONFIG_MODULE_SIG=y CONFIG_MODULE_SIG_FORCE=y CONFIG_MODULE_SIG_ALL=y CONFIG_MODULE_SIG_SHA512=y CONFIG_MODULE_SIG_HASH="sha512" CONFIG_MODULE_SIG_KEY="certs/signing_key.pem" CONFIG_SYSTEM_TRUSTED_KEYS="certs/oppo_mods_signing.pem" CONFIG_LOCALVERSION="-perf" CONFIG_SECCOMP=y CONFIG_SECCOMP_FILTER=y CONFIG_DEBUG_INFO=n CONFIG_DEBUG_FS=n CONFIG_BALANCE_ANON_FILE_RECLAIM=n CONFIG_MSM_IDLE_STATS=n

# ---------------------------------------------------------------------
# AnyKernel3 / 打包
# ---------------------------------------------------------------------
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# 不要动 dtbo：本机 dtbo 是官方 19 条目版本，第三方 dtbo 只有 6 条目，
# 刷了会影响显示/触控
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ---------------------------------------------------------------------
# Runner
# ---------------------------------------------------------------------
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
