diff --git a/fs/stat.c b/fs/stat.c
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -66,11 +66,36 @@ EXPORT_SYMBOL(generic_fillattr);
  * filehandle lookup code, which uses only the inode number and returns no
  * attributes to any user.  Any other code probably wants vfs_getattr.
  */
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+extern __attribute__((cold)) bool susfs_is_current_app_uid(void);
+extern __attribute__((cold)) bool susfs_is_inode_sus_kstat(struct inode *inode, bool *is_fuse);
+extern __attribute__((cold)) void susfs_sus_kstat_spoof_generic_fillattr(struct inode *inode, struct kstat *stat);
+#endif // #ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+
 int vfs_getattr_nosec(const struct path *path, struct kstat *stat,
 		      u32 request_mask, unsigned int query_flags)
 {
 	struct inode *inode = d_backing_inode(path->dentry);
 
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	if (susfs_is_current_app_uid()) {
+		bool is_fuse = false;
+
+		if (susfs_is_inode_sus_kstat(inode, &is_fuse)) {
+			if (inode->i_op->getattr) {
+				int error = inode->i_op->getattr(path, stat, request_mask,
+								  query_flags);
+				if (error)
+					return error;
+			} else {
+				generic_fillattr(inode, stat);
+			}
+			susfs_sus_kstat_spoof_generic_fillattr(inode, stat);
+			return 0;
+		}
+	}
+#endif // #ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+
 	memset(stat, 0, sizeof(*stat));
 	stat->result_mask |= STATX_BASIC_STATS;
 	request_mask &= STATX_ALL;
