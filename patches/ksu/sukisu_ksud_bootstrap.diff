+        extern int ksu_bootstrap_install_ksud(const char *src_path);
+
+        if (ksu_manager_uid_authorized(current_uid().val) &&
+            ksu_bootstrap_install_ksud(filename->name) > 0)
+            escape_with_root_profile();
+    }
