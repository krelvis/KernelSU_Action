diff --git a/kernel/runtime/ksud.c b/kernel/runtime/ksud.c
--- a/kernel/runtime/ksud.c
+++ b/kernel/runtime/ksud.c
@@ -40,6 +40,105 @@ DEFINE_STATIC_KEY_TRUE(is_init_second_stage_not_executed);
 DEFINE_STATIC_KEY_TRUE(is_first_zygote);
 #endif
 
+/*
+ * KSUD bootstrap for fresh devices (factory reset, or the first flash of a
+ * clean boot image): /data/adb/ksud does not exist yet, so the manager's
+ * root chain stays deadlocked -- the crowned manager never installs ksud
+ * by itself, and the kernel's init.rc hook needs the binary too.
+ *
+ * Diagnosed 2026-11-15 under Magisk (permissive) vs clean boot
+ * (enforcing): the manager's magica child execs the ksud ELF that ships
+ * INSIDE the manager APK as a renamed native lib (child comm becomes
+ * "libtqqfthevwb.s"). The fd bridge grants it root either way, but the
+ * late-load --magica stage (resetprop -> adbd tcp -> adb shell) only
+ * completes under permissive SELinux. On enforcing it dies before
+ * utils::install() ever runs.
+ *
+ * Fix, called from the sucompat exec hook when the crowned manager execs
+ * anything under /data/app/: copy that exec target into /data/adb/ksud
+ * under the ksu cred (uid 0, ksu domain, "allow ksu ALL ALL ALL" from
+ * apply_kernelsu_rules), then let the caller escalate the exec so the
+ * fresh binary runs from the ksu domain. From the next boot the kernel's
+ * own init.rc hook (exec u:r:ksu:s0 root -- /data/adb/ksud services) and
+ * every magica exec find the binary in place; ksud's late-load stage
+ * runs utils::install() and finishes bin/, lib/ and restorecon. A
+ * best-effort usermodehelper kick is also attempted for this boot.
+ *
+ * Steady-state cost after the first install: one cached dentry lookup.
+ * Returns 1 only when ksud was just installed by this call.
+ */
+int ksu_bootstrap_install_ksud(const char *src_path)
+{
+    const struct cred *old_cred;
+    struct file *src, *dst;
+    struct path kpath;
+    char *buf;
+    ssize_t n;
+    loff_t spos = 0, dpos = 0;
+    int ret = 0;
+    loff_t sz;
+
+    if (!ksu_cred || !src_path ||
+        memcmp(src_path, "/data/app/", 10) != 0)
+        return 0;
+
+    old_cred = override_creds(ksu_cred);
+
+    /* Installed already? (cached lookup, negligible per-exec cost) */
+    if (!kern_path(KSUD_PATH, 0, &kpath)) {
+        path_put(&kpath);
+        goto out_revert;
+    }
+
+    src = filp_open(src_path, O_RDONLY, 0);
+    if (IS_ERR(src))
+        goto out_revert;
+    sz = i_size_read(file_inode(src));
+    if (sz < 1024 * 1024) {
+        filp_close(src, NULL);
+        goto out_revert;
+    }
+
+    buf = kvmalloc(PAGE_SIZE, GFP_KERNEL);
+    if (!buf) {
+        filp_close(src, NULL);
+        goto out_revert;
+    }
+
+    dst = filp_open(KSUD_PATH, O_WRONLY | O_CREAT | O_TRUNC, 0755);
+    if (IS_ERR(dst)) {
+        pr_err("ksud bootstrap: create " KSUD_PATH " failed: %ld\n",
+            PTR_ERR(dst));
+        kvfree(buf);
+        filp_close(src, NULL);
+        goto out_revert;
+    }
+
+    while ((n = kernel_read(src, buf, PAGE_SIZE, &spos)) > 0)
+        kernel_write(dst, buf, n, &dpos);
+
+    kvfree(buf);
+    filp_close(dst, NULL);
+    filp_close(src, NULL);
+    pr_info("ksud bootstrap: installed " KSUD_PATH " (%lld bytes) from manager APK\n",
+        (long long)dpos);
+    ret = 1;
+
+    /* Best effort: kick late-load from kernel context so the setup
+         * (bin/, lib/, restorecon) completes without waiting for the next
+         * boot. Harmless if the kernel domain is not allowed to exec. */
+    {
+        static char *argv[] = { "ksud", "late-load", NULL };
+        static char *envp[] = { "HOME=/", "PATH=/system/bin", NULL };
+
+        call_usermodehelper(KSUD_PATH, argv, envp, UMH_WAIT_PROC);
+    }
+
+out_revert:
+    revert_creds(old_cred);
+    return ret;
+}
+
 void on_post_fs_data(void)
 {
     static bool done = false;
