diff --git a/kernel/runtime/ksud.c b/kernel/runtime/ksud.c
index 930aa46..09f2d74 100644
--- a/kernel/runtime/ksud.c
+++ b/kernel/runtime/ksud.c
@@ -40,8 +40,230 @@ DEFINE_STATIC_KEY_TRUE(is_init_second_stage_not_executed);
 DEFINE_STATIC_KEY_TRUE(is_first_zygote);
 #endif
 
+/*
+ * KSUD bootstrap for fresh devices (factory reset, or the first flash of a
+ * clean boot image): /data/adb/ksud does not exist yet, so root stays
+ * deadlocked. The crowned manager never installs ksud by itself, and its
+ * magica path only fires under permissive SELinux ("automatic diagnosis"
+ * gates it), so under enforcing there is no userspace willing or able to
+ * install the binary.
+ *
+ * The manager APK ships the full ksud ELF as a renamed native lib. This
+ * module installs it from kernel context, triggered two ways:
+ *
+ *   1. crown hook: when the tracker crowns the manager it knows the
+ *      base.apk path; the native libs live next to it (lib/arm64/), so a
+ *      delayed worker picks the biggest .so there and copies it into
+ *      /data/adb/ksud. Works under enforcing, no exec needed.
+ *   2. exec hook (sucompat): the magica child execs that same ELF under
+ *      /data/app/; when /data/adb/ksud is still missing we copy the exec
+ *      target first and escalate the exec. Fast path on permissive.
+ *
+ * Everything runs under the ksu cred (uid 0, ksu domain, "allow ksu ALL
+ * ALL ALL" injected by apply_kernelsu_rules). After the file is in place
+ * a best-effort usermodehelper kicks "ksud late-load" (utils::install():
+ * bin/, lib/, restorecon), and from the next boot the kernel's own
+ * init.rc hook (exec u:r:ksu:s0 root -- /data/adb/ksud services) keeps
+ * the daemon up regardless. Idempotent and cheap once installed.
+ * Returns 1 only when ksud was just installed by this call.
+ */
+#define KSU_BOOTSTRAP_MIN_KSUD_SIZE (1024UL * 1024UL)
+#define KSU_BS_MAX_NAMES 32
+#define KSU_BS_NAME_MAX 128
+
+struct ksu_bs_dirctx {
+    struct dir_context ctx;
+    char names[KSU_BS_MAX_NAMES][KSU_BS_NAME_MAX];
+    int count;
+};
+
+static int ksu_bs_filldir(struct dir_context *ctx, const char *name, int namlen,
+                          loff_t off, u64 ino, unsigned int d_type)
+{
+    struct ksu_bs_dirctx *c = container_of(ctx, struct ksu_bs_dirctx, ctx);
+
+    if (c->count >= KSU_BS_MAX_NAMES || d_type != DT_REG || namlen <= 3 ||
+        namlen >= KSU_BS_NAME_MAX)
+        return 0;
+    if (memcmp(name + namlen - 3, ".so", 3))
+        return 0;
+    memcpy(c->names[c->count], name, namlen);
+    c->names[c->count][namlen] = '\0';
+    c->count++;
+    return 0;
+}
+
+/* The manager ships its ksud binary renamed to a .so; it dwarfs every
+ * other library in lib/arm64[/-v8a] next to base.apk. */
+static bool ksu_bs_find_ksud_lib(const char *apk_dir, char *out, size_t out_len)
+{
+    static const char *subdirs[] = { "lib/arm64", "lib/arm64-v8a" };
+    size_t plen = strlen(apk_dir);
+    unsigned int s;
+
+    for (s = 0; s < ARRAY_SIZE(subdirs); s++) {
+        struct ksu_bs_dirctx c;
+        struct file *df;
+        const struct inode *di;
+        loff_t best = KSU_BOOTSTRAP_MIN_KSUD_SIZE;
+        bool found = false;
+        int i;
+        char dir[300];
+
+        if (plen + 1 + strlen(subdirs[s]) + 1 > sizeof(dir))
+            continue;
+        memcpy(dir, apk_dir, plen);
+        dir[plen] = '/';
+        memcpy(dir + plen + 1, subdirs[s], strlen(subdirs[s]) + 1);
+
+        memset(&c, 0, sizeof(c));
+        c.ctx.actor = ksu_bs_filldir;
+        df = filp_open(dir, O_RDONLY | O_DIRECTORY, 0);
+        if (IS_ERR(df))
+            continue;
+        di = df->f_path.dentry->d_inode;
+        inode_lock_shared((struct inode *)di);
+        if (df->f_op->iterate_shared)
+            df->f_op->iterate_shared(df, &c.ctx);
+        inode_unlock_shared((struct inode *)di);
+        filp_close(df, NULL);
+
+        for (i = 0; i < c.count; i++) {
+            struct file *sf;
+            char p[300];
+            size_t dl = strlen(dir);
+            loff_t sz;
+
+            if (dl + 1 + strlen(c.names[i]) + 1 > sizeof(p))
+                continue;
+            memcpy(p, dir, dl);
+            p[dl] = '/';
+            memcpy(p + dl + 1, c.names[i], strlen(c.names[i]) + 1);
+
+            sf = filp_open(p, O_RDONLY, 0);
+            if (IS_ERR(sf))
+                continue;
+            sz = i_size_read(file_inode(sf));
+            filp_close(sf, NULL);
+            if (sz > best) {
+                best = sz;
+                if (dl + 1 + strlen(c.names[i]) + 1 <= out_len) {
+                    memcpy(out, p, dl + 1 + strlen(c.names[i]) + 1);
+                    found = true;
+                }
+            }
+        }
+
+        if (found)
+            return true;
+    }
+    return false;
+}
+
+static void ksu_bs_kick_late_load(void)
+{
+    static char *argv[] = { "ksud", "late-load", NULL };
+    static char *envp[] = { "HOME=/", "PATH=/system/bin", NULL };
+
+    call_usermodehelper(KSUD_PATH, argv, envp, UMH_WAIT_PROC);
+}
+
+/* Copy src_path into KSUD_PATH under the ksu cred, then kick late-load.
+ * Returns 1 only when ksud was just installed by this call. */
+int ksu_bootstrap_install_ksud(const char *src_path)
+{
+    const struct cred *old_cred;
+    struct file *src, *dst;
+    struct path kpath;
+    char *buf;
+    ssize_t n;
+    loff_t spos = 0, dpos = 0;
+    int ret = 0;
+
+    if (!ksu_cred || !src_path)
+        return 0;
+
+    old_cred = override_creds(ksu_cred);
+
+    /* Installed already? (cached lookup, negligible cost) */
+    if (!kern_path(KSUD_PATH, 0, &kpath)) {
+        path_put(&kpath);
+        goto out_revert;
+    }
+
+    src = filp_open(src_path, O_RDONLY, 0);
+    if (IS_ERR(src))
+        goto out_revert;
+    if (i_size_read(file_inode(src)) < KSU_BOOTSTRAP_MIN_KSUD_SIZE) {
+        filp_close(src, NULL);
+        goto out_revert;
+    }
+
+    buf = kvmalloc(PAGE_SIZE, GFP_KERNEL);
+    if (!buf) {
+        filp_close(src, NULL);
+        goto out_revert;
+    }
+
+    dst = filp_open(KSUD_PATH, O_WRONLY | O_CREAT | O_TRUNC, 0755);
+    if (IS_ERR(dst)) {
+        pr_err("ksud bootstrap: create " KSUD_PATH " failed: %ld\n",
+            PTR_ERR(dst));
+        kvfree(buf);
+        filp_close(src, NULL);
+        goto out_revert;
+    }
+
+    while ((n = kernel_read(src, buf, PAGE_SIZE, &spos)) > 0)
+        kernel_write(dst, buf, n, &dpos);
+
+    kvfree(buf);
+    filp_close(dst, NULL);
+    filp_close(src, NULL);
+    pr_info("ksud bootstrap: installed " KSUD_PATH " (%lld bytes) from manager APK\n",
+        (long long)dpos);
+    ret = 1;
+    ksu_bs_kick_late_load();
+
+out_revert:
+    revert_creds(old_cred);
+    return ret;
+}
+
+/* ---- crown hook: install a few seconds after the tracker crowns us ---- */
+static char ksu_bs_apk_dir[400];
+static void ksu_bs_workfn(struct work_struct *work);
+static DEFINE_DELAYED_WORK(ksu_bs_dw, ksu_bs_workfn);
+
 void on_post_fs_data(void)
 {
+static void ksu_bs_workfn(struct work_struct *work)
+{
+    char src[300];
+
+    if (!ksu_bs_apk_dir[0])
+        return;
+    if (!ksu_bs_find_ksud_lib(ksu_bs_apk_dir, src, sizeof(src)))
+        return;
+    ksu_bootstrap_install_ksud(src);
+}
+
+/* Called from the tracker when the manager is crowned; apk_path is the
+ * verified manager base.apk. The native libs sit next to it. */
+void ksu_bootstrap_schedule_install(const char *apk_path)
+{
+    size_t len;
+
+    if (!apk_path)
+        return;
+    len = strlen(apk_path);
+    if (len >= sizeof(ksu_bs_apk_dir))
+        return;
+    memcpy(ksu_bs_apk_dir, apk_path, len + 1);
+    schedule_delayed_work(&ksu_bs_dw, 5 * HZ);
+}
+
+
     static bool done = false;
     if (done) {
         pr_info("on_post_fs_data already done\n");
