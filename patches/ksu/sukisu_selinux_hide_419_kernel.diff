+
+#ifdef CONFIG_KSU
+/* KernelSU: selinux_hide debug -- decode and log denials that policy dontaudit
+ * rules would otherwise suppress, so silent app-domain rejections (exec of the
+ * manager CLI, etc.) become visible in dmesg. */
+static void ksu_avc_dbg_log_deny(struct selinux_state *state, u32 ssid, u32 tsid, u16 tclass, u32 requested, u32 avd_allowed)
+{
+	char *scon = NULL, *tcon = NULL;
+	u32 slen = 0, tlen = 0;
+	bool decoded = false;
+
+	if (!in_atomic()) {
+		decoded = !security_sid_to_context(state, ssid, &scon, &slen) &&
+			  !security_sid_to_context(state, tsid, &tcon, &tlen);
+	}
+
+	if (decoded)
+		pr_info_ratelimited("KSU-AVCDBG: DENY uid=%d comm=%s ssid=%u tsid=%u scon=%s tcon=%s tclass=%s(%u) req=0x%x avd_allowed=0x%x\n",
+				    current_uid().val, current->comm, ssid, tsid, scon ?: "?", tcon ?: "?",
+				    (tclass && tclass < ARRAY_SIZE(secclass_map)) ? secclass_map[tclass - 1].name : "?",
+				    (unsigned)tclass, requested, avd_allowed);
+	else
+		pr_info_ratelimited("KSU-AVCDBG: DENY uid=%d comm=%s ssid=%u tsid=%u tclass=%u req=0x%x avd_allowed=0x%x (atomic)\n",
+				    current_uid().val, current->comm, ssid, tsid,
+				    (unsigned)tclass, requested, avd_allowed);
+
+	kfree(scon);
+	kfree(tcon);
+}
+#endif
