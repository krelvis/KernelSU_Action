+    // Lock/allocation order mirrors stock security_read_policy() EXACTLY:
+    // estimate the size under a brief read lock, allocate OUTSIDE the lock
+    // (vmalloc may sleep and we run in PID1's execve context via
+    // ksu_handle_execveat_ksud -- allocating under a spinlock would be
+    // scheduling-while-atomic), then take the lock again only for the
+    // policydb_write(). The (sleepable) parse runs outside the lock too.
+    if (!ksu_selinux_hide_backup_419) {
+        rwlock_t *bklock = ksu_get_policy_rwlock();
+        struct policydb *bkdb = get_policydb();
+        void *bkdata = NULL;
+        size_t bklen = 0, best = 0;
+        struct ksu_sepolicy419 *bk;
+        int bret;
+
+        if (bklock)
+            read_lock(bklock);
+        best = ksu_sepolicy419_bufsize(bkdb);
+        if (bklock)
+            read_unlock(bklock);
+
+        bkdata = vmalloc(best);
+        if (!bkdata) {
+            pr_err("sepolicy419: alloc policy buffer len %zu\n", best);
+        } else {
+            if (bklock)
+                read_lock(bklock);
+            bret = ksu_sepolicy419_serialize_into(bkdb, bkdata, best, &bklen);
+            if (bklock)
+                read_unlock(bklock);
+
+            if (bret) {
+                pr_err("failed to serialize pristine policy for selinux_hide backup\n");
+                vfree(bkdata);
+            } else {
+                bk = ksu_sepolicy419_materialize(bkdata, bklen);
+                vfree(bkdata);
+                if (IS_ERR(bk)) {
+                    pr_err("failed to materialize backup sepolicy: %ld\n", PTR_ERR(bk));
+                } else {
+                    ksu_selinux_hide_backup_419 = bk;
+                    pr_info("selinux_hide: backup sepolicy captured! types nprim=%u\n",
+                            bk->policydb.p_types.nprim);
+                }
+            }
+        }
+    }
+#endif
+
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
     mutex_lock(&selinux_state.policy_mutex);
 
@@ -262,6 +315,14 @@ out_flush:
