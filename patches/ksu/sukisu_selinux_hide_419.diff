 }
 
diff --git a/kernel/selinux/sepolicy.c b/kernel/selinux/sepolicy.c
index 6b4e0ef..03bac68 100644
--- a/kernel/selinux/sepolicy.c
+++ b/kernel/selinux/sepolicy.c
@@ -1270,3 +1270,124 @@ out_free_data:
     return ERR_PTR(ret);
 }
 #endif
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0)
+
+// The ss includes below the >=5.10 block are gated out on 4.19; bring the
+// pieces this section needs. ss/policydb.h is already pulled in transitively
+// via selinux/sepolicy.h (see rules.c), but include explicitly for clarity.
+#include "ss/policydb.h"
+#include "ss/sidtab.h"
+
+/*
+ * Serialized-size estimate for the given policydb. Called under the live
+ * policy read lock (brief, no allocation). Mirrors stock
+ * security_policydb_len(); the extra nprim padding covers the ebitmap
+ * entries policydb_read() reconstructs that policydb_write() omits.
+ */
+size_t ksu_sepolicy419_bufsize(struct policydb *src)
+{
+    return src->len + (size_t)src->p_types.nprim * (sizeof(u32) + sizeof(u64));
+}
+
+/*
+ * Serialize the given policydb into a CALLER-ALLOCATED buffer.
+ * NO locking, NO allocation here: the caller (rules.c) mirrors stock
+ * security_read_policy() -- estimate size under a brief read lock, allocate
+ * OUTSIDE the lock (vmalloc may sleep and we run in PID1's execve context),
+ * then take the lock again only for the policydb_write().
+ * Returns 0 on success and sets *len_out to the serialized length.
+ */
+int ksu_sepolicy419_serialize_into(struct policydb *src, void *data, size_t len,
+                                   size_t *len_out)
+{
+    struct policy_file fp;
+    int ret;
+
+    fp.data = data;
+    fp.len = len;
+
+    ret = policydb_write(src, &fp);
+    if (ret) {
+        pr_err("sepolicy419: policydb_write: %d\n", ret);
+        return ret;
+    }
+    len -= fp.len;
+    // fixup config
+    // 4*2+8+4
+    static const size_t kConfigOff = 20;
+    if (len >= kConfigOff + sizeof(u32)) {
+        u32 *config_ptr = (u32 *)((unsigned long)data + kConfigOff);
+        if (src->android_netlink_route) {
+            pr_info("adding POLICYDB_CONFIG_ANDROID_NETLINK_ROUTE\n");
+            *config_ptr |= POLICYDB_CONFIG_ANDROID_NETLINK_ROUTE;
+        }
+        if (src->android_netlink_getneigh) {
+            pr_info("adding POLICYDB_CONFIG_ANDROID_NETLINK_GETNEIGH\n");
+            *config_ptr |= POLICYDB_CONFIG_ANDROID_NETLINK_GETNEIGH;
+        }
+    }
+    *len_out = len;
+    return 0;
+}
+
+struct ksu_sepolicy419 *ksu_sepolicy419_materialize(void *data, size_t len)
+{
+    struct ksu_sepolicy419 *new_pol;
+    struct policy_file fp;
+    int ret;
+
+    new_pol = kzalloc(sizeof(*new_pol), GFP_KERNEL);
+    if (!new_pol)
+        return ERR_PTR(-ENOMEM);
+    memset(&new_pol->policydb, 0, sizeof(new_pol->policydb));
+
+    fp.data = data;
+    fp.len = len;
+
+    ret = policydb_read(&new_pol->policydb, &fp);
+    if (ret) {
+        pr_err("sepolicy419: policydb_read: %d\n", ret);
+        goto out_free_pol;
+    }
+    new_pol->policydb.len = len;
+
+    new_pol->sidtab = kzalloc(sizeof(*new_pol->sidtab), GFP_KERNEL);
+    if (!new_pol->sidtab) {
+        ret = -ENOMEM;
+        goto out_free_pol;
+    }
+    ret = policydb_load_isids(&new_pol->policydb, new_pol->sidtab);
+    if (ret) {
+        pr_err("sepolicy419: policydb_load_isids: %d\n", ret);
+        goto out_free_sidtab;
+    }
+
+    return new_pol;
+
+out_free_sidtab:
+    sidtab_destroy(new_pol->sidtab);
+    kfree(new_pol->sidtab);
+
+out_free_pol:
+    policydb_destroy(&new_pol->policydb);
+    kfree(new_pol);
+
+    return ERR_PTR(ret);
+}
+
+void ksu_destroy_sepolicy419(struct ksu_sepolicy419 *pol)
+{
+    if (!pol)
+        return;
+    if (pol->sidtab) {
+        sidtab_destroy(pol->sidtab);
+        kfree(pol->sidtab);
+        pol->sidtab = NULL;
+    }
+    policydb_destroy(&pol->policydb);
+    kfree(pol);
+}
+
+#endif
+
