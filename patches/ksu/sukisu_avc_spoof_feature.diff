diff --git a/kernel/feature/avc_spoof.c b/kernel/feature/avc_spoof.c
new file mode 100644
--- /dev/null
+++ b/kernel/feature/avc_spoof.c
@@ -0,0 +1,32 @@
+/*
+ * Manager "AVC log spoofing" toggle bridge.
+ *
+ * The manager queries/sets kernel feature ID 10003 (KSU_FEATURE_AVC_SPOOF).
+ * SukiSU builtin f9aa2fe predates that feature ID, so the kernel reported
+ * NOT_SUPPORTED and the manager toggle stayed grey even though the underlying
+ * susfs command channel (CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING ->
+ * susfs_set_avc_log_spoofing()) is fully functional.
+ *
+ * This handler flips the susfs static key directly; get reads its live state,
+ * so a state applied via `ksud susfs enable-avc-log-spoofing` is reflected.
+ */
+#include <linux/printk.h>
+#include <linux/jump_label.h>
+
+extern struct static_key_false susfs_is_avc_log_spoofing_enabled;
+
+static int avc_spoof_feature_get(u64 *value)
+{
+    *value = static_key_enabled(&susfs_is_avc_log_spoofing_enabled.key) ? 1 : 0;
+    return 0;
+}
+
+static int avc_spoof_feature_set(u64 value)
+{
+    if (value) {
+        static_branch_enable(&susfs_is_avc_log_spoofing_enabled);
+        pr_info("avc_spoof: enabled\n");
+    } else {
+        static_branch_disable(&susfs_is_avc_log_spoofing_enabled);
+        pr_info("avc_spoof: disabled\n");
+    }
+    return 0;
+}
+
+static const struct ksu_feature_handler avc_spoof_handler = {
+    .feature_id = KSU_FEATURE_AVC_SPOOF,
+    .name = "avc_spoof",
+    .get_handler = avc_spoof_feature_get,
+    .set_handler = avc_spoof_feature_set,
+};
+
+void __init ksu_avc_spoof_init(void)
+{
+    if (ksu_register_feature_handler(&avc_spoof_handler)) {
+        pr_err("avc_spoof: failed to register feature handler\n");
+    }
+}
